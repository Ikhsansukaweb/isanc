# =============================================================================
#  TEMPLATE KONFIGURASI — IsanC (afk-bedrock)
# =============================================================================
#
#  CARA PAKAI (3 langkah):
#
#    1. Salin berkas ini menjadi .env
#         cp .env.example .env
#
#    2. Isi setiap nilai di bawah ini dengan nilai aslimu.
#       Baris yang WAJIB diisi sudah ditandai  ← WAJIB.
#
#    3. Amankan berkasnya supaya tidak terbaca pengguna lain di komputer ini:
#         chmod 600 .env
#
# -----------------------------------------------------------------------------
#  ATURAN PENTING
# -----------------------------------------------------------------------------
#
#  * Berkas .env yang sudah terisi JANGAN PERNAH di-commit ke GitHub.
#    Berkas ini sudah diblokir otomatis oleh .gitignore.
#    Yang boleh masuk repo hanya .env.example (template ini).
#
#  * JANGAN menaruh nilai asli di berkas TEMPLATE ini.
#    Template ditulis untuk dibaca orang lain — isi hanya contoh/nilai palsu.
#
#  * Kalau ada nilai yang mengandung karakter khusus (#, $, spasi, tanda kutip),
#    bungkus dengan tanda kutip ganda. Contoh:
#        DB_PASSWORD="pa#ss word$123"
#    Tanpa tanda kutip, karakter # dianggap awal komentar sehingga sisanya
#    terpotong dan aplikasi gagal konek database.
#
#  * JANGAN tambahkan spasi di sekitar tanda = . Tulis NAMA=nilai,
#    bukan NAMA = nilai.
#
#  * Setiap kali kamu menambah variabel baru di kode, tambahkan juga di sini
#    (tanpa nilai asli) supaya orang lain tahu variabel itu dibutuhkan.
#
# =============================================================================


# -----------------------------------------------------------------------------
#  SERVER
# -----------------------------------------------------------------------------

# Port backend. Harus sama dengan sumber `PORT` di src/server.ts.
PORT=3737

# Alamat frontend yang diizinkan mengakses API (CORS).
# Pisahkan dengan koma kalau lebih dari satu. Jangan pakai tanda bintang (*).
#   contoh lokal : http://localhost:3000
#   contoh publik: https://skadesmart.web.id
CORS_ORIGINS=https://skadesmart.web.id


# -----------------------------------------------------------------------------
#  DATABASE (MySQL)
# -----------------------------------------------------------------------------
#  Siapkan databasenya dulu:
#      mysql -u root -p -e "CREATE DATABASE isanc CHARACTER SET utf8mb4;"
#      mysql -u root -p isanc < data/schema.mysql.sql

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=isanc
DB_USER=root

#  ← WAJIB. Password MySQL milikmu.
#  Bungkus dengan tanda kutip kalau mengandung karakter khusus.
DB_PASSWORD="ganti-dengan-password-mysql-mu"


# -----------------------------------------------------------------------------
#  RAHASIA APLIKASI
# -----------------------------------------------------------------------------
#  Dua nilai di bawah ini WAJIB dibuat acak dan berbeda satu sama lain.
#  Cara membuat nilai acak (jalankan di terminal, salin hasilnya):
#
#      node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
#  JANGAN pakai nilai contoh di bawah — kalau dipakai, siapa pun yang membaca
#  repo ini bisa memalsukan sesi login (JWT) atau menembus lapisan internal.

#  ← WAJIB. Kunci penandatanganan token login (JWT).
#  Kalau diganti sewaktu aplikasi jalan, semua pengguna akan ter-logout.
JWT_SECRET=ganti-dengan-nilai-acak-96-karakter

#  ← WAJIB. Kunci komunikasi antar-proses internal.
#  Dipakai untuk request yang datang dari proses internal (bukan dari browser).
INTERNAL_SECRET=ganti-dengan-nilai-acak-64-karakter


# -----------------------------------------------------------------------------
#  PEMBAYARAN QRIS  (isi saldo)
# -----------------------------------------------------------------------------
#  Gateway: ariepulsa. Ambil API key dari dasbor penyedianya.

QRIS_URL=https://ariepulsa.com/api/qrisgo

#  ← WAJIB kalau ingin fitur isi saldo aktif.
QRIS_API_KEY=isi-api-key-qris-dari-dashboard-gateway

#  Catatan teknis (tidak perlu diubah):
#  * Deposit baru wajib menyertakan reff_id unik + type_fee=1.
#  * Gateway ini TIDAK mengirim URL gambar QR. Gambar disusun sendiri dari
#    kode deposit dengan pola  <QRIS_URL>/assets/images/qris/<kode>.png
#    (lihat buildQrisImageUrl di src/lib/qris.ts).
#  * Kalau kamu berganti gateway, sesuaikan pola URL gambarnya di sana.


# -----------------------------------------------------------------------------
#  FOTO PROFIL  (catbox.moe)
# -----------------------------------------------------------------------------
#  Ambil userhash dari: https://catbox.moe/user/manage.php
#  (login dulu ke akun catbox-mu; userhash ada di bagian bawah halaman)
#
#  Kosongkan kalau tidak butuh fitur unggah foto profil.

CATBOX_USERHASH=isi-userhash-catbox-mu


# -----------------------------------------------------------------------------
#  AI  (opsional)
# -----------------------------------------------------------------------------
#  Kosongkan kalau tidak dipakai. Bisa pakai penyedia apa pun yang
#  API-nya kompatibel dengan format OpenAI.

AI_API_KEY=
AI_BASE_URL=
AI_MODEL=


# -----------------------------------------------------------------------------
#  BATAS REQUEST  (rate limit)
# -----------------------------------------------------------------------------
#  Melindungi server dari penyalahgunaan. Silakan sesuaikan.
#  Angka terlalu kecil = pengguna wajar bisa terblokir.

#  Batas total request per IP (semua endpoint).
RATE_LIMIT_MAX=20000

#  Batas percobaan login gagal per kombinasi IP + username,
#  sebelum akun terkunci sementara.
LOGIN_RATE_LIMIT_MAX=10

#  Batas percobaan login gagal per IP saja (semua username).
#  Lindungi dari percobaan menyapu banyak akun sekaligus.
LOGIN_RATE_LIMIT_IP=50

#  Batas kirim pesan di Global Chat.
CHAT_RATE_LIMIT=120


# =============================================================================
#  SELESAI. Setelah diisi:
#
#    1. Pastikan MySQL jalan       : sudo systemctl status mysql
#    2. Bangun backend             : npm run build
#    3. Jalankan                   : pm2 start dist/index.js --name afk-api
#    4. Bangun frontend            : cd web && npm run build
#    5. Jalankan frontend          : cd web && npm start
#    6. Uji                        : curl http://localhost:3737/api/health
#
#  Konfigurasi frontend ada di berkas terpisah:  web/.env.example
# =============================================================================
