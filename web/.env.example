# =============================================================================
#  TEMPLATE KONFIGURASI FRONTEND — web/
# =============================================================================
#
#  CARA PAKAI:
#    1. Salin berkas ini menjadi .env.local
#         cp web/.env.example web/.env.local
#    2. Isi nilainya (lihat penjelasan di bawah).
#    3. Bangun ulang frontend supaya nilai ini terpakai:
#         cd web && npm run build
#
#  Catatan: Next.js membaca variabel berawalan NEXT_PUBLIC_ saat BUILD,
#  bukan saat jalan. Jadi kalau nilainya diubah, wajib `npm run build` lagi —
#  sekadar restart `npm start` tidak cukup.
#
#  Berkas .env.local TIDAK boleh di-commit (sudah diblokir .gitignore).
#
# =============================================================================


# -----------------------------------------------------------------------------
#  ALAMAT BACKEND
# -----------------------------------------------------------------------------
#  URL backend yang dipanggil BROWSER pengguna (bukan localhost, kecuali
#  kamu menjalankan semuanya di komputer sendiri).
#
#     lokal  : http://localhost:3737
#     publik : https://api.skadesmart.web.id
#
NEXT_PUBLIC_API_URL=https://api.skadesmart.web.id


# -----------------------------------------------------------------------------
#  PEMBAYARAN QRIS  (harus cocok dengan backend)
# -----------------------------------------------------------------------------
#  Dipakai HANYA untuk menentukan origin gambar QR di header keamanan CSP
#  (lihat web/next.config.mjs). Gambar QR dilayani dari domain gateway yang
#  sama dengan QRIS_URL di berkas .env backend. Samakan nilainya.
#
QRIS_URL=https://ariepulsa.com/api/qrisgo


# =============================================================================
#  KENAPA INI PENTING
# =============================================================================
#
#  Nilai di atas menentukan izin pada Content-Security-Policy (CSP) yang
#  dikirim ke browser:
#
#    NEXT_PUBLIC_API_URL  ->  connect-src   (request API & WebSocket)
#    QRIS_URL             ->  img-src       (gambar QR di halaman Saldo)
#
#  Kalau nilai di sini TIDAK SAMA dengan yang benar-benar dipanggil kode,
#  browser akan memblokir request/gambar tersebut. Gejalanya membingungkan:
#  halaman tampak normal, tapi login gagal, chat tidak jalan, atau gambar QR
#  hilang tanpa pesan yang jelas di layar (hanya muncul di Console browser).
#
#  Jadi: selalu samakan berkas ini dengan nilai yang dipakai backend.
# =============================================================================
